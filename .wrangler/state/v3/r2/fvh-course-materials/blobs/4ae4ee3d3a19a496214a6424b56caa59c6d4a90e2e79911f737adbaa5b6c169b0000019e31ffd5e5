      .lesson-card {
        box-shadow: none;
        border: 0;
        border-radius: 0;
      }

      .lesson-card::before {
        display: none;
      }

      .lesson-inner {
        display: block;
        padding: 0;
      }

      .lesson-header {
        position: static;
